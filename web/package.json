{
    "name": "mdlogger-web",
    "private": true,
    "version": "0.0.0",
    "license": "GPL-3.0-or-later",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build --sourcemap",
        "lint": "eslint .",
        "generate:icons": "node scripts/generate-pwa-icons.mjs",
        "generate:licenses": "node scripts/generate-third-party-notices.mjs",
        "preview": "vite preview",
        "test": "vitest run && node --test scripts/check-secrets.node-test.mjs scripts/generate-third-party-notices.node-test.mjs",
        "check:licenses": "node scripts/generate-third-party-notices.mjs --check",
        "check:license-artifacts": "node scripts/check-generated-license-artifacts.mjs",
        "check:license-bundle": "node scripts/generate-third-party-notices.mjs --check-bundle dist",
        "strip:source-maps": "node scripts/remove-source-maps.mjs dist",
        "check:secrets": "node scripts/check-secrets.mjs dist",
        "check:deploy-env": "node scripts/check-deploy-env.mjs",
        "deploy": "npm audit && npm run check:deploy-env && npm run check:licenses && npm run check:license-artifacts && npm run build && npm run check:license-bundle && npm run strip:source-maps && npm run check:secrets && wrangler deploy",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.118.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router-dom": "^7.18.4"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^10.13.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.13.0",
        "jsdom": "^30.1.3",
        "sharp": "^0.35.5",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.0",
        "vite": "^8.3.5",
        "vite-plugin-pwa": "^2.0.0",
        "vitest": "^5.0.5",
        "wrangler": "^4.152.0"
    },
    "overrides": {
        "miniflare@5.20261019.2-beta": {
            "undici": "7.30.1"
        }
    }
}
