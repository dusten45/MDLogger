# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so

# ---- Virtual environment (uv) ----
.venv/
venv/
env/

# Note: uv.lock and .python-version are intentionally committed for reproducibility.

# ---- Test / tooling caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.serena/
.agents/
.cache/
.coverage
.coverage.*
coverage/
htmlcov/
.hypothesis/

# ---- Generated build config (see scripts/generate_build_config.py) ----
# publishable(anon) Supabase 값을 담아 PyInstaller가 번들한다. 커밋 금지.
src/mdlogger/remote/_bundled_config.py

# ---- PyInstaller build output ----
build/
dist/
*.manifest
# Keep the .spec if you want a reusable build recipe. This project's
# "마듀 듀얼로그 생성기.spec" hardcodes a local icon path (D:\Downloads\asdf.ico),
# so .spec files are ignored by default. The MDLogger.spec is a clean, generic
# recipe (no local paths) and IS tracked for reproducible builds:
*.spec
!MDLogger.spec

# ---- Runtime data (recreated on first launch via ensure_data_dir) ----
# The SQLite DB is per-user gameplay data, and decks_sync.json is local ETag state.
# The canonical decks list lives on a GitHub Gist (see src/mdlogger/paths.py
# DECKS_REMOTE_URL); no project-root decks.json is tracked anymore. Only the
# bundled catalog inside the package (src/mdlogger/data/) is committed.
data/
# 번들 덱 카탈로그는 패키지 내부이며 커밋한다(하드닝 N-4). 위의 `data/` 규칙을 예외 처리.
!src/mdlogger/data/
!src/mdlogger/data/decks.json
*.db
*.sqlite
*.sqlite3

# ---- Exported files ----
games.csv
games.xlsx

# ---- Supabase CLI scratch dirs ----
supabase/.branches/
supabase/.temp/
supabase/snippets/

# ---- Supabase function local env (service-role key 등 비밀). 커밋 금지. ----
supabase/functions/.env.local
supabase/functions/**/.env.local

# ---- Local dev env (MDLogger Supabase anon key 등). 커밋 금지. ----
/.env
/.env.local

# ---- AI agents & assistants (1인 개발 로컬 전용 설정 및 지침) ----
AGENTS.md
AGENTS.*.md
CLAUDE.md
CLAUDE.*.md
GEMINI.md
GEMINI.*.md
COPILOT.md
.claude/
.gemini/
.cursor/
.windsurf/
.copilot/

# ---- Web / Node build artifacts ----
web/node_modules/
web/dist/
web/dist-ssr/
web/.wrangler/

# ---- Local documentation (kept out of VCS) ----
# 개발 과정 문서와 운영·제품 계획 문서는 로컬 전용으로 둔다.
# 릴리스 노트와 공개 법률 문서는 저장소에서 버전 관리한다.
docs/*
!docs/release.md
!docs/privacy-policy.md
!docs/terms-of-service.md

