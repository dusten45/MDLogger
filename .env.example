# MDLogger 로컬 개발용 Supabase 설정 예시.
# 이 파일을 복사해 같은 위치에 `.env`로 저장하고 값을 채운 뒤 사용한다.
#   cp .env.example .env
# `.env`는 커밋 금지(.gitignore 대상). service-role/secret key를 넣지 말 것.
#
# 로컬 Supabase 스택(`supabase start`)을 띄운 경우:
#   - URL: http://127.0.0.1:54321
#   - anon key: `supabase start` 출력의 "anon key" 값
# hosted 프로젝트를 개발에 쓰는 경우:
#   - URL: https://<project-ref>.supabase.co
#   - anon key: Project Settings > API Keys 의 anon public key

MDLOGGER_SUPABASE_URL=http://127.0.0.1:54321
MDLOGGER_SUPABASE_ANON_KEY=your-anon-key-here
